# Copy to .env and override before any non-demo deployment.
# ---------------------------------------------------------------
# MySQL (standalone process, never an embedded/in-memory DB)
MYSQL_ROOT_PASSWORD=webox_root_pwd
DB_PASSWORD=webox_pwd
MYSQL_PORT=3306

# Backend / frontend host ports
API_PORT=8080
WEB_PORT=8081

# Auth: MUST be replaced in production (>= 32 chars, random)
JWT_SECRET=webox-dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Hot menu cache TTL (seconds)
MENU_CACHE_TTL_SECONDS=30

# AI recommendation: any OpenAI-compatible endpoint (OpenAI / Ollama / vLLM ...)
# Leave LLM_API_KEY empty -> built-in local recommendation engine is used (still fully runnable).
# Ollama example (host machine): LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
